{
  "name": "acornary",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/server/src/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "initialize": "tsx apps/server/src/initialize.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "better-auth": "1.7.5",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
